# Copy to .env and adjust. Never commit .env.
# The values below are LOCAL DEVELOPMENT defaults matching docker-compose.yml.

# PostgreSQL connection for the app, migrations and seed
DATABASE_URL=postgres://branchflow:branchflow@localhost:5432/branchflow

# Database used by integration tests. Its contents are DELETED by the test suite.
TEST_DATABASE_URL=postgres://branchflow:branchflow@localhost:5432/branchflow_test

# Identity source.
#   dev  = development-only synthetic identity (refuses to run when NODE_ENV=production)
#   none = no identity; the app shows a "no authentication configured" state
AUTH_MODE=dev

# Synthetic user used when no development identity has been selected.
DEV_AUTH_DEFAULT_USER_EMAIL=avery.manager@lakeshore.synthetic.branchflow.test
